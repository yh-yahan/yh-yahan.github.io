---
layout: layout.njk
section: writeups
---
<a href="/writeups/" class="text-sm text-stone-500 hover:text-stone-900 dark:text-zinc-500 dark:hover:text-zinc-300">← Writeups</a>

<header class="mt-4 mb-10">
  <h1 class="text-3xl font-semibold tracking-tight text-stone-900 dark:text-zinc-100">{{ title }}</h1>

  {% if subtitle %}
  <p class="mt-2 text-sm text-stone-500 dark:text-zinc-500">{{ subtitle }}</p>
  {% endif %}

  <div class="mt-2 text-sm text-stone-500 dark:text-zinc-500">
    {{ date | readableDate }}
    {% if category %}
    <span class="ml-2">· {{ category }}</span>
    {% endif %}
  </div>
</header>

<article class="prose prose-stone dark:prose-invert max-w-none">
  {{ content | safe }}
</article>
