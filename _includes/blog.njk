---
layout: layout.njk
section: blogs
---
<a href="/blogs/" class="text-sm text-stone-500 hover:text-stone-900 dark:text-zinc-500 dark:hover:text-zinc-300 transition">← Blog</a>

<header class="mt-5 mb-10">
  <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-stone-900 dark:text-zinc-100">
    {{ title }}
  </h1>

  {% if subtitle %}
  <p class="mt-3 text-base text-stone-500 dark:text-zinc-500">{{ subtitle }}</p>
  {% endif %}

  <div class="mt-4 flex items-center gap-3 text-sm text-stone-500 dark:text-zinc-500">
    {{ date | readableDate }}
    {% if reading_time %}
    <span>·</span>
    <span>{{ reading_time }} min read</span>
    {% endif %}
  </div>

  {% if category %}
  <div class="mt-4 flex flex-wrap gap-2">
    <span class="px-2 py-1 rounded-md text-xs bg-stone-200 dark:bg-zinc-800 text-stone-600 dark:text-zinc-400">{{ category }}</span>
  </div>
  {% endif %}
</header>

<article class="prose prose-stone dark:prose-invert max-w-3xl prose-headings:font-semibold prose-a:text-stone-700 dark:prose-a:text-zinc-300">
  {{ content | safe }}
</article>
